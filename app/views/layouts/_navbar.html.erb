<% if breadcrumb_trail.any? %>
  <nav aria-label="breadcrumb" class="fancy-breadcrumbs">
    <ol class="breadcrumb-list">
      <% breadcrumb_trail.each_with_index do |crumb, index| %>
        
        <% if index == breadcrumb_trail.size - 1 %>
          <%# Último elemento: Píldora destacada con degradado %>
          <li class="breadcrumb-item active" aria-current="page">
            <%= crumb[:name] %>
          </li>
        <% else %>
          <%# Elementos anteriores: Enlaces con efecto hover %>
          <li class="breadcrumb-item">
            <%= link_to crumb[:name], crumb[:path] %>
          </li>
        <% end %>

      <% end %>
    </ol>
  </nav>
<% end %>

<style>
  /* Contenedor flotante tipo "Píldora" */
  .fancy-breadcrumbs {
    background: #ffffff;
    padding: 10px 20px;
    border-radius: 50px; /* Bordes totalmente redondeados */
    box-shadow: 0 4px 15px rgba(0,0,0,0.06); /* Sombra suave */
    margin-bottom: 30px;
    border: 1px solid #f0f0f0;
    display: inline-block; /* Hace que el fondo se ajuste al contenido */
  }
  
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
  }

  /* Separador elegante (Flecha Chevron) */
  .breadcrumb-item + .breadcrumb-item::before {
    content: "❯"; /* Símbolo más estilizado que la barra / */
    display: inline-block;
    padding: 0 14px;
    color: #c5cbd5;
    font-size: 12px;
  }

  /* Enlaces con efecto hover de burbuja */
  .breadcrumb-item a {
    color: #007bff;
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 20px;
    transition: all 0.3s ease;
    background-color: transparent;
  }

  .breadcrumb-item a:hover {
    background-color: #e0f0ff; /* Fondo azul clarito al pasar el mouse */
    color: #0056b3;
    transform: translateY(-1px);
  }

  /* El paso actual: Muy vistoso, con color y sombra */
  .breadcrumb-item.active {
    color: white; 
    background: linear-gradient(135deg, #007bff, #00c6ff); /* Degradado vibrante */
    padding: 6px 18px;
    border-radius: 20px;
    font-weight: 600;
    box-shadow: 0 3px 8px rgba(0,123,255,0.3); /* Resplandor azul */
    letter-spacing: 0.3px;
  }
</style>